[Desktop Entry]
Type=Application
Name=Media Link Launcher
Comment=Open web media links in VLC media player
Exec="@HANDLER_EXEC@" %u
Terminal=false
NoDisplay=true
MimeType=x-scheme-handler/media-link-launcher;
Categories=AudioVideo;Utility;
X-Media-Link-Launcher-ID=media-link-launcher
X-Media-Link-Launcher-Version=0.2.1
